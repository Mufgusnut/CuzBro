# Supabase project settings. Keep the service-role key ONLY on the observatory PC.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
HBG3_STATION=eliot
DEW_POLL_SECONDS=2

# Recommended: call the local dew script that already knows how to control HBG3.
DEW_ADAPTER=command
# Available placeholders: {channel} (0/1), {channel1} (1/2), {mode},
# {aggression}, {manual_pwm}, {manualPwm}, {pwm}
HBG3_DEW_COMMAND=powershell.exe -NoProfile -ExecutionPolicy Bypass -File "C:\CuzBro\hbg3-bridge\set-hbg3-dew.ps1" -Channel {channel} -Mode {mode} -Aggression {aggression} -ManualPwm {manual_pwm}
DEW_COMMAND_TIMEOUT=15

# Test queue processing without touching hardware:
DEW_DRY_RUN=false
LOG_LEVEL=INFO

# Optional direct Telnet adapter. Leave templates blank until verified against
# the exact HBG3 firmware command syntax installed on your unit.
HBG3_HOST=192.168.4.1
HBG3_TELNET_PORT=3000
HBG3_TELNET_AUTO_TEMPLATE=
HBG3_TELNET_MANUAL_TEMPLATE=
HBG3_TELNET_LINE_ENDING=\r\n
