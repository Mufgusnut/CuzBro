SUPABASE_URL=https://qhvjhvxhvolywkxgdxxy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PASTE_YOUR_EXISTING_SERVICE_ROLE_KEY_HERE
STATION=eliot
ASIAIR_OUTPUT_DIR="\\10.0.0.113\EMMC Images"
ASIAIR_POLL_SECONDS=2
ASIAIR_SESSION_GAP_SECONDS=300
ASIAIR_EXTENSIONS=.fit,.fits,.fts
ASIAIR_PREVIEW_ENABLED=1
ASIAIR_PREVIEW_BUCKET=asiair-previews
ASIAIR_PREVIEW_MAX_WIDTH=1100

# Android ASIAIR control
ASIAIR_ANDROID_CONTROL_ENABLED=1
ADB_PATH=C:\platform-tools\adb.exe
# Recommended: paste the exact device ID from `adb devices`. Leave blank only when one device is connected.
ADB_SERIAL=emulator-5554
ASIAIR_ANDROID_PACKAGE=com.zwoasi.asiair
ASIAIR_ANDROID_ACTIVITY=
# Delay between every tap/swipe in a chained Android command.
ASIAIR_CHAIN_DELAY_SECONDS=0.5

# Mode menu and destinations
ASIAIR_TAP_MODE_MENU=2310,225
ASIAIR_TAP_MODE_PREVIEW=1600,450
ASIAIR_TAP_MODE_AUTORUN=1600,640
ASIAIR_TAP_MODE_VIDEO=1600,800
ASIAIR_TAP_MODE_FOCUS=1600,275
ASIAIR_TAP_MODE_LIVE=2000,460

# Main capture/start/stop button
ASIAIR_TAP_CAPTURE=2310,560

# Settings and continuous-preview sequence
ASIAIR_TAP_SETTINGS=1300,60
ASIAIR_SWIPE_SETTINGS_START=2200,820
ASIAIR_SWIPE_SETTINGS_END=2200,180
ASIAIR_TAP_CONTINUOUS_STEP_1=1787,846
ASIAIR_TAP_CONTINUOUS_STEP_2=2282,539
ASIAIR_TAP_CONTINUOUS_TOGGLE=692,430

# Gain entry sequence
ASIAIR_TAP_GAIN_FIELD=2190,550
ASIAIR_TAP_KEYPAD_CLEAR=1530,390
ASIAIR_TAP_KEYPAD_ENTER=1515,715
ASIAIR_TAP_KEYPAD_1=900,520
ASIAIR_TAP_KEYPAD_2=1100,517
ASIAIR_TAP_KEYPAD_3=1350,512
ASIAIR_TAP_KEYPAD_4=890,650
ASIAIR_TAP_KEYPAD_5=1085,650
ASIAIR_TAP_KEYPAD_6=1325,650
ASIAIR_TAP_KEYPAD_7=885,775
ASIAIR_TAP_KEYPAD_8=1093,775
ASIAIR_TAP_KEYPAD_9=1320,775
ASIAIR_TAP_KEYPAD_0=1534,515

# Experimental read-only ASIAIR protocol monitor.
# Set this to the ASIAIR's Station Mode / LAN IP address.
ASIAIR_PROTOCOL_MONITOR_ENABLED=1
ASIAIR_HOST=10.0.0.113
ASIAIR_PROTOCOL_PORTS=4400,4700
ASIAIR_PROTOCOL_RECONNECT_SECONDS=3

# Direct ASIAIR JSON control (replaces Android/ADB for supported commands)
ASIAIR_DIRECT_CONTROL_ENABLED=1
ASIAIR_DIRECT_CONTROL_PORT=4700
